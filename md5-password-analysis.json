    },
    "md5_ff": {
      "type": "function",
      "stringValue": "function md5_ff(C,B,G,F,A,E,D){return md5_cmn((B&G)|((~B)&F),C,B,A,E,D)}"
    },
    "md5_gg": {
      "type": "function",
